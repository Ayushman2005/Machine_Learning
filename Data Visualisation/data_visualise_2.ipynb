   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "np.random.seed(0)\n",
    "scores = np.random.normal(70,10,100)\n",
    "plt.hist(scores, color=\"skyblue\", edgecolor=\"black\", bins=20)\n",
    "plt.ylabel(\"Number of Students\")\n",
    "plt.xlabel(\"Scores\")\n",
    "plt.title(\"Distribution of Student Scores\")"
   ]
